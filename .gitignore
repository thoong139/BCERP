# MCV3 working data (chính sách 2026-09-12 theo yêu cầu user): .mc-data/ được TRACK và
# push GitHub — "đảm bảo toàn bộ dữ liệu làm việc MCV3 đồng bộ GitHub". State per-machine
# vẫn ignore (checkpoint.json mọi độ sâu, locks, caches, implement/scan sessions) —
# xem section ".mc-data/ RUNTIME STATE" và các section wf-* bên dưới.
.mc-data-eval/
.mc-data-eval-real/
docs/audit/work/

# Secrets - never commit
*.pem
*.key
secrets/
.secrets/
.claude/scheduled_tasks.lock

# wf-scan-target (Sprint 6 multi-dev safety — Q2 = A)
# Per-machine cache: fingerprint phụ thuộc absolute path → KHÔNG sync cross-machine
# Transient locks: PID + host metadata, không sync (cross-host kill -0 không khả thi)
# scans-index.jsonl + history.jsonl + session folders KHÔNG ignore — git-sync friendly,
# auto-merge JSONL (mỗi entry 1 dòng độc lập) cho team chia sẻ lịch sử scan.
.mc-data/work/wf-scan-target/_shared/cache/
.mc-data/work/wf-scan-target/sessions/*/.lock

# wf-implement-feature v4.0 (Sprint 1 — design intent for multi-dev safety)
# Chính sách ĐÃ ĐỔI (2026-09-12): .mc-data/ được un-ignore và track lên GitHub.
# Quy tắc gốc giữ nguyên: sessions/, current.txt, .locks/, .cache/ KHÔNG sync
# (per-machine state); .history/implementations-index.jsonl SHOULD sync (audit trail).
.mc-data/work/wf-implement-feature/*/sessions/
.mc-data/work/wf-implement-feature/*/current.txt
.mc-data/work/wf-implement-feature/*/archived/
.mc-data/work/wf-implement-feature/.locks/
.mc-data/work/wf-implement-feature/.cache/

.omc

