# ============================================================
# .mc-data/ RUNTIME STATE (folder gốc được track — chỉ ignore state per-machine)
# ============================================================
# Runtime checkpoints per-machine (mọi độ sâu, kể cả trong sessions/) — KHÔNG ảnh hưởng
# checkpoint.json template trong .claude/skills/
.mc-data/work/**/checkpoint.json
.mc-data/work/**/checkpoint.json.tmp
# CI cache lock (per-machine)
.mc-data/work/_meta/*.lock
# Hook-generated sync state (giữ .gitkeep đã track)
.mc-data/sync/sync-status.md

