    },
    "standard": {
      "probes_required": [
        "P-QD10-cross-module-ref-static",
        "P-QD10-api-contract-drift",
        "P-QD10-event-handler-coverage"
      ],
      "max_signals_per_probe": 50,
      "notes": "3 static probes — bao phu reference drift + API contract + event handlers. Khong can DB/dev server."
    },
    "deep": {
      "probes_required": [
        "P-QD10-cross-module-ref-static",
        "P-QD10-api-contract-drift",
        "P-QD10-event-handler-coverage",
        "P-QD10-orphan-reference-runtime",
        "P-QD10-multi-platform-entity-sync",
        "P-QD10-llm-analysis"
      ],
      "max_signals_per_probe": 100,
      "notes": "Static + 2 runtime probes (orphan FK, multi-platform sync). Can DB credentials + base_url cho mobile/erp apps."
    },
    "exhaustive": {
      "probes_required": "ALL",
      "max_signals_per_probe": 300,
      "notes": "All 9 probes. Cache-staleness opt-in via --test-cache-sync (mutation safety). State-machine + business-flow + auth-matrix can YAML specs (graceful skip neu thieu)."
    }
