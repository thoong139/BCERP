  "severity_rules": {
    "critical_triggers": [
      "Orphan FK reference: consumer rows reference provider rows khong ton tai (data integrity violation)",
      "Authorization matrix missing guard tren endpoint mutation (Broken Access Control — OWASP Top 10)"
    ],
    "high_triggers": [
      "API contract field removed/renamed (breaking change without migration)",
      "State machine cho phep illegal transition (vd: PENDING -> COMPLETED khong qua APPROVED)",
      "Business flow step unreachable hoac assertion fail (Q2C flow broken)",
      "Event handler completely missing for declared event subscription",
      "Multi-platform entity response shape mismatch (mobile <-> erp)",
      "Authorization matrix thieu role guard tren endpoint can authentication"
    ],
    "medium_triggers": [
      "Consumer importing deprecated provider export",
      "API contract type mismatch non-breaking (vd: number -> bigint)",
      "Cache staleness > 5s on entity sync",
      "Multi-platform entity field mismatch (subset of fields differ)",
      "Event handler partial coverage (some event types subscribed, some missing)",
      "Authorization matrix over-permissive (roles_forbidden contains role nhung code accept role do)"
    ],
    "low_triggers": [
      "Consumer missing optional field that is now used in provider",
      "Cross-module reference uses internal symbol (not exported officially)"
    ],
    "max_aggregation": true
  },
