import { test, expect, type Page, type APIRequestContext } from "@playwright/test";

// ─── Config ──────────────────────────────────────────────────────────────────
const BASE_URL = process.env.BASE_URL ?? "http://localhost:3000";
const API_URL  = process.env.API_URL  ?? "http://localhost:5048";
const AUTH     = { email: "{PRIMARY_ACTOR_EMAIL}", password: "{PRIMARY_ACTOR_PASSWORD}" };
const LOCALE   = "vi";

// ─── Helpers ─────────────────────────────────────────────────────────────────
async function login(page: Page) {
  await page.goto(`${BASE_URL}/${LOCALE}/login`);
  await page.getByLabel(/email/i).fill(AUTH.email);
  await page.getByLabel(/password|mật khẩu/i).fill(AUTH.password);
  await page.getByRole("button", { name: /đăng nhập|login/i }).click();
  await page.waitForURL(/\/dashboard/, { timeout: 15_000 });
}

async function apiPost(request: APIRequestContext, path: string, body: object, token: string) {
  return request.post(`${API_URL}${path}`, {
    data: body,
    headers: { Authorization: `Bearer ${token}`, "Content-Type": "application/json" },
  });
}

// ─── Auth Setup ──────────────────────────────────────────────────────────────
let accessToken = "";

test.beforeAll(async ({ request }) => {
  const res = await request.post(`${API_URL}/api/v1/auth/login`, {
    data: { userNameOrEmail: AUTH.email, password: AUTH.password },
  });
  expect(res.status(), "Login phải trả 200").toBe(200);
  const body = await res.json();
  accessToken = body.accessToken;
  expect(accessToken, "accessToken không được rỗng").toBeTruthy();
});

