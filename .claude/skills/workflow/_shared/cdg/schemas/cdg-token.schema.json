{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "cdg-token-v1",
  "title": "CDG Token",
  "description": "Schema cho 1 CDG (Critical Decision Gate) token",
  "type": "object",
  "required": ["cdg_id", "context", "decision", "created_at"],
  "properties": {
    "cdg_id": {
      "type": "string",
      "description": "Định danh CDG (vd: cdg-workload-override-001)",
      "minLength": 1
    },
    "cdg_point": {
      "type": "string",
      "description": "CDG point ID (CDG-1 đến CDG-7)"
    },
    "context": {
      "type": "string",
      "description": "Mô tả context cho user",
      "minLength": 10
    },
    "decision": {
      "type": "string",
      "enum": ["pending", "accept", "reject"],
      "description": "User decision"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Thời gian tạo"
    },
    "resolved_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "Thời gian resolve (null nếu pending)"
    },
    "metadata": {
      "type": "object",
      "description": "Metadata tùy chọn"
    }
  }
}
