{
  "locale": "en",
  "description": "English CTA (Call-To-Action) keyword patterns for UI probe detection",
  "cta_patterns": [
    {"text": "buy now",        "category": "purchase",      "regex": "buy\\s+now"},
    {"text": "add to cart",    "category": "purchase",      "regex": "add\\s+to\\s+cart"},
    {"text": "shop now",       "category": "purchase",      "regex": "shop\\s+now"},
    {"text": "order now",      "category": "purchase",      "regex": "order\\s+now"},
    {"text": "checkout",       "category": "purchase",      "regex": "check\\s*out"},
    {"text": "sign up",        "category": "registration",  "regex": "sign\\s+up"},
    {"text": "register",       "category": "registration",  "regex": "register"},
    {"text": "get started",    "category": "registration",  "regex": "get\\s+started"},
    {"text": "create account", "category": "registration",  "regex": "create\\s+account"},
    {"text": "join now",       "category": "registration",  "regex": "join\\s+now"},
    {"text": "subscribe",      "category": "subscription",  "regex": "subscribe"},
    {"text": "try free",       "category": "subscription",  "regex": "try\\s+(for\\s+)?free"},
    {"text": "free trial",     "category": "subscription",  "regex": "free\\s+trial"},
    {"text": "learn more",     "category": "discovery",     "regex": "learn\\s+more"},
    {"text": "view more",      "category": "discovery",     "regex": "view\\s+more"},
    {"text": "see more",       "category": "discovery",     "regex": "see\\s+more"},
    {"text": "discover",       "category": "discovery",     "regex": "discover"},
    {"text": "explore",        "category": "discovery",     "regex": "explore"},
    {"text": "book now",       "category": "booking",       "regex": "book\\s+now"},
    {"text": "reserve",        "category": "booking",       "regex": "reserve"},
    {"text": "contact us",     "category": "contact",       "regex": "contact\\s+us"},
    {"text": "get quote",      "category": "contact",       "regex": "get\\s+(a\\s+)?quote"},
    {"text": "request demo",   "category": "contact",       "regex": "request\\s+(a\\s+)?demo"},
    {"text": "download",       "category": "download",      "regex": "download"},
    {"text": "apply now",      "category": "application",   "regex": "apply\\s+now"},
    {"text": "submit",         "category": "form",          "regex": "submit"},
    {"text": "confirm",        "category": "form",          "regex": "confirm"},
    {"text": "continue",       "category": "form",          "regex": "continue"},
    {"text": "next",           "category": "form",          "regex": "\\bnext\\b"},
    {"text": "login",          "category": "auth",          "regex": "log\\s*in|sign\\s+in"}
  ]
}
