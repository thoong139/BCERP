{
  "$schema": "skill-contract-v1",
  "skill": "wf-e2e-scenario",
  "version": "1.4.0",
  "phase": "F7 — Playwright MCP scenario test (execute test-scenario.md)",
  "description": "F7 trong chuỗi wf-e2e-* (chia tách từ wf-e2e-verify v6.5.0 Phase 7 phần scenario). Chạy test-scenario.md qua Playwright MCP → fill Pass/Fail + screenshots. Cross-module scenarios LUÔN included. v1.1.0 (2026-05-14): Failure Analysis Engine — classify root cause 7 loại + resolution direction. v1.3.0 (2026-05-14): Auto-Fix 2-Phase — Phase 1 browser fix (selector fallback / re-login / transient retry / page reload / UI create data), Phase 2 source-code fix (spawn agent: qa-lead/developer/frontend-developer/dba + domain expert co-spawn). Fix tất cả failure_type trừ UNKNOWN. Post-fix wait HMR + re-verify.",
  "procedure": [
    "procedures/_shared.md",
    "procedures/scenario-runner.md",
    "procedures/screenshot-evidence.md",
    "procedures/resume-status.md",
    "procedures/failure-analyzer.md"
  ],
  "prerequisites": {
    "required_files": [
      ".mc-data/work/wf-e2e-verify/sessions/{session-id}/outputs/test-scenario.md"
    ],
    "required_conditions": [
      "Session tồn tại",
      "test-scenario.md có ≥1 scenario",
      "Playwright MCP available",
      "FE running (localhost:3000)",
      "--session=<id> được cung cấp"
    ],
    "forensic_validation": "grep -c '^## Kịch bản' test-scenario.md | awk '$1>=1{exit 0} {exit 1}'"
  },
  "inputs": [
    {
      "path": ".mc-data/work/wf-e2e-verify/sessions/{session-id}/outputs/test-scenario.md",
      "required": true,
      "description": "Test scenarios skeleton từ F1"
    },
    {
      "path": ".mc-data/work/wf-e2e-verify/sessions/{session-id}/findings/",
      "required": true,
      "description": "Context findings (BR catalog, state-machine)"
    },
    {
      "path": "<FEAT-ID arg>",
      "required": true,
      "description": "Feature ID"
    },
    {
      "path": "--session=<id> arg",
      "required": true,
      "description": "Session ID"
    }
  ],
  "outputs": {
    "docs": [],
    "working": [
      {
        "path": ".mc-data/work/wf-e2e-verify/sessions/{session-id}/F7-scenario/status.json",
        "required": true,
        "template": "templates/status.template.json",
        "description": "F7 state — scenarios_total, scenarios_executed, current_scenario_idx"
      },
      {
        "path": ".mc-data/work/wf-e2e-verify/sessions/{session-id}/F7-scenario/scenario-test-report.md",
        "required": true,
        "template": null,
        "description": "Summary report: tổng số scenario, pass/fail count, evidence links"
      },
      {
        "path": ".mc-data/work/wf-e2e-verify/sessions/{session-id}/outputs/test-scenario.md",
        "required": true,
        "template": "templates/test-scenario.template.md",
        "description": "UPDATE per row: fill 'Kết quả thực tế' + 'Pass/Fail' columns + screenshot link"
      },
      {
        "path": ".mc-data/work/wf-e2e-verify/sessions/{session-id}/screenshots/",
        "required": true,
        "template": null,
        "description": "scenario-{NN}-{slug}.png evidence files + login-result.png"
      },
      {
        "path": ".mc-data/work/wf-e2e-verify/sessions/{session-id}/F7-scenario/Phase-report.md",
        "required": true,
        "template": ".claude/doc-framework/_meta/phase-summary.template.md",
        "description": "CORE-028 F7 summary"
      },
      {
        "path": ".mc-data/work/wf-e2e-verify/sessions/{session-id}/F7-scenario/resolution-report.md",
        "required": false,
        "template": null,
        "description": "v1.1.0: Failure Analysis Engine output — bảng failure_type / affected_layer / resolution_direction / suggested_owner per FAIL scenario. Chỉ sinh khi có ≥1 scenario FAIL.",
        "condition": "FAIL_COUNT > 0"
      }
    ]
  },
  "registry_scope": {
    "fields_owned": [],
    "write_role": "NONE"
  },
  "cross_skill_contracts": {
    "produces_for": {
      "wf-e2e-verify": [".mc-data/work/wf-e2e-verify/sessions/{id}/outputs/test-scenario.md (filled)"]
    },
    "consumes_from": {
      "wf-e2e-test": [".mc-data/work/wf-e2e-verify/sessions/{id}/outputs/test-scenario.md (skeleton)"]
    },
    "shares_lock_with": ["wf-e2e-browser", "wf-e2e-demo"],
    "lock_name": "browser-mcp.lock",
    "spawned_by": "wf-e2e-verify orchestrator (sau F6 fix)"
  },
  "ci": {
    "enabled": true,
    "pre_gate": {
      "Na": "bash .claude/scripts/ci-detect.sh",
      "Nb": "bash .claude/scripts/ci-freshness-check.sh",
      "Nc": "bash .claude/scripts/ci-inject-context.sh"
    },
    "fallback": "Grep/Glob",
    "reference": "CORE-033"
  },
  "errors": {
    "namespace": "E070-E082",
    "description": "F7 Playwright scenario execution + Failure Analysis Engine + Auto-Fix Engine",
    "ledger": {
      "file": "$SESSION_DIR/error-ledger.json",
      "format": "APPEND-only JSONL",
      "reference": "CORE-034"
    }
  },
  "error_namespace": {
    "range": "E070-E081",
    "specific": {
      "E070": "test-scenario.md không tồn tại",
      "E071": "Playwright MCP không available",
      "E072": "FE không running",
      "E073": "Login fail",
      "E074": "Browser lock conflict",
      "E075": "Navigate fail",
      "E076": "Snapshot không match expected (UI bug → ISSUE → failure-analyzer)",
      "E077": "Screenshot capture fail",
      "E078": "POST-GATE BR mismatch",
      "E079": "Atomic write fail",
      "E080": "Failure analysis inconclusive — UNKNOWN classification (warning, không block)",
      "E081": "Evidence collection partial — console/network unavailable (warning, không block)",
      "E082": "Auto-fix exhausted — đã thử strategy nhưng vẫn fail, giữ FAIL gốc (warning, không block)"
    }
  }
}
