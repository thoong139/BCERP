{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "inventory-doc-classified-v1",
  "title": "Inventory: Pre-classified Documents (DOCS_ONLY mode)",
  "description": "Pre-classified docs khi maturity == DOCS_ONLY (source_count == 0). Chỉ tạo ra trong DOCS_ONLY mode. Output: .mc-data/work/legacy-scan/inventory/doc-classified.json",
  "type": "object",
  "required": ["count", "is_docs_only", "items"],
  "properties": {
    "count": {
      "type": "integer",
      "minimum": 0,
      "description": "Tổng số docs đã classify"
    },
    "is_docs_only": {
      "type": "boolean",
      "const": true,
      "description": "Luôn true — file này chỉ tồn tại trong DOCS_ONLY mode"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "doc_type", "size_bytes"],
        "properties": {
          "path": {
            "type": "string",
            "description": "Relative path từ project root"
          },
          "doc_type": {
            "type": "string",
            "enum": ["spec", "guide", "api", "readme", "changelog", "api_spec"],
            "description": "Loại tài liệu — dùng cho downstream classify skill"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
