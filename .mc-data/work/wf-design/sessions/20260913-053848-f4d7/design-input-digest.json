      "COMP-CORE-001 IdP SSO/MFA",
      "COMP-CORE-002 RBAC PDP",
      "COMP-CORE-005 WORM Store",
      "COMP-CORE-009 Realtime P&L",
      "COMP-ERP-001 Sales & Pipeline",
      "COMP-ERP-002 Finance & Treasury",
      "COMP-ERP-003 Ad Account & Delivery",
      "COMP-ERP-006 SLA & Notification Worker",
      "COMP-ERP-007 Batch & Recon Scheduler",
      "COMP-GW-001 Connector Registry (DI-004)",
      "COMP-GW-002 Credentials Vault",
      "COMP-GW-005 Degraded & Backfill",
      "COMP-PORTAL-002 Portal BFF DMZ"
    ],
    "communication_style": "REST /api/v1 sync + Kafka events (outbox, idempotent, DLQ) + OIDC/OAuth2 SSO tập trung; mobile qua BFF; portal read-model polling"
  },
