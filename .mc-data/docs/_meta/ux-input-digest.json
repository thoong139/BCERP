   "Platform Admin /admin (RBAC + Audit)",
   "Settings /settings (Integration & Settings) — 7 workspace nội bộ (R2 13/09); Portal: Home/Campaign/Hóa đơn/Hỗ trợ; Mobile ESS: 5 tabs; Mobile Portal: 5 tabs"
  ],
  "user_flows": [
   {
    "flow_name": "Lead → Gate → Handoff → Campaign",
    "screens": [
     "My Pipeline",
     "Lead 360",
     "Deal Desk",
     "Handoff Bridge",
     "TKQC Registry",
     "Campaign 360"
    ]
   },
