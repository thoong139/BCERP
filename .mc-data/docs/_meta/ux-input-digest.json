     "Portal Home",
     "Campaign theo dõi",
     "Billing",
     "Ticket"
    ]
   }
  ]
 },
 "responsive_strategy": "Desktop-first (≥1280px base, max-width queries 1279/767); nav rail + command bar; split view master-detail; mobile chỉ transactional ngắn (ESS/portal), data-heavy grid không render trên mobile (\"Mở trên web\"); portal: comfortable density + bottom nav <768px",
 "accessibility": {
  "wcag_level": "AA (WCAG 2.1 + 8 bổ sung §8.1: A1-A8)",
  "keyboard_navigation": true,
  "screen_reader_ready": true
 },
