 "design_decisions": [
  {
   "decision": "Workspace-first menu (7 workspaces: 5 theo phòng ban + 2 quản trị đặc thù Platform Admin/Settings — R2 13/09) thay vì menu theo module",
   "rationale": "R2/R3 — menu theo công việc của phòng ban, không theo hệ thống; R2 (13/09) tách Settings thành workspace riêng + bổ sung bảng phân bổ 19 phân hệ/170 FEAT theo workspace (Navigation §1.0)"
  },
  {
   "decision": "Consolidation 28 proposed → 24 web surfaces (drop hard-stop panel, notification page; merge lệnh chi → tab AR/AP; handoff 1 surface 2 role views)",
   "rationale": "Minimum necessary screen set — mỗi screen có justification (Step 2.0 v4.1)"
  },
  {
   "decision": "Client 360 hub dùng chung + link-out",
   "rationale": "R12 — không nhân bản dữ liệu khách trên 7 surfaces"
  },
  {
   "decision": "Keyboard-first approval inbox (A/R/Enter/Space) + MFA step-up",
   "rationale": "Money-safety UX; FIN/CEO duyệt nhiều"
  },
  {
   "decision": "BEM bcerp-* (web), bcportal-* (portal), bcportal-m-* (mobile portal), PWA cho mobile ESS",
   "rationale": "Trust boundary external phản ánh vào CSS namespace; tokens CSS custom properties tái dùng 100%"
  }
 ],
