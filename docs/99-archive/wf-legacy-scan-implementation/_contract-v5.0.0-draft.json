    "backward_compat_guarantees": [
      "standard profile = v4.1 output parity (ADR-LS15 lock verified via fixture tests in Phase D).",
      "CLI flags --resume, --status, --re-vision, --batch-size unchanged.",
      "Downstream skills (wf-brainstorm, wf-design, etc.) consume same file paths."
