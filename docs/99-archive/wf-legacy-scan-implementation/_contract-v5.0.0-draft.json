{
  "$schema": "skill-contract-v1",
  "skill": "wf-legacy-scan",
  "version": "5.0.0-draft",
  "phase": "pre-phase0",
  "description": "Scan toan dien du an hien co (v5.0): session-based + 4 profiles + IPS 2-phase + incremental/cache. Backward-compat v4.1 tren standard profile.",
  "procedure": "procedures/flow.md",
  "design_refs": {
    "master_plan": "docs/design/skills/wf-legacy-scan/implementation/00-master-plan.md",
    "session_protocol": "docs/design/skills/wf-legacy-scan/implementation/01-session-protocol.md",
    "data_model": "docs/design/skills/wf-legacy-scan/04-data-model.md",
    "profiles_ips": "docs/design/skills/wf-legacy-scan/05-profiles-ips.md",
    "vn_keywords": "docs/design/skills/wf-legacy-scan/10-vietnamese-keywords.md",
    "adrs": "docs/design/skills/wf-legacy-scan/08-tradeoffs-adr.md"
  },
  "prerequisites": {
    "files": [],
    "registry_fields": [],
    "notes": "Entry point cho legacy path — chi can project directory ton tai. PROJECT_PATH = argument hoac CWD. Optional: legacy-decisions.json va cache directory."
  },
  "inputs": {
    "required": [
      {
        "path": "<project-path>",
        "description": "Duong dan den thu muc goc cua du an hien co (argument hoac CWD)"
      }
    ],
    "optional": [
      {
        "path": ".mc-data/work/wf-brainstorm/legacy-decisions.json",
        "description": "Legacy decisions bridge (CORE-022) — doc neu ton tai de enforce DEPRECATED modules"
      },
      {
        "path": ".mc-data/cache/wf-legacy-scan/",
        "description": "Project-level cache (opt-in via --cache-publish) — tai su dung ket qua probe giua cac session"
      }
    ]
  },
  "cli_flags": {
    "backward_compat": [
      "--resume",
      "--status",
      "--re-vision",
      "--batch-size"
    ],
    "new_v5": [
      "--profile",
      "--layers",
      "--depth",
      "--session",
      "--incremental",
      "--since",
      "--no-cache",
      "--cache-publish"
    ],
    "deferred_v5_1": [
      "--workload",
      "--chunk",
      "--aggregate"
    ]
  },
  "profiles": ["surface", "standard", "deep", "exhaustive"],
  "default_profile": "standard",
  "profile_notes": "standard profile = v4.1 backward-compat LOCK (ADR-LS03/LS15). Surface = light-weight. Deep/exhaustive = thorough + domain enrichment.",
  "outputs": {
    "docs": [],
    "working": [
      {
        "path": ".mc-data/work/legacy-scan/sessions/{id}/scan-state.json",
        "template": "templates/scan-state.json",
        "required": true,
        "description": "Session state (v5.0 canonical). Replace legacy-scan-status.json. Atomic write qua scan_state_reader.py helper."
      },
      {
        "path": ".mc-data/work/legacy-scan/sessions/{id}/scan-plan.md",
        "template": "templates/scan-plan.md",
        "required": true,
        "description": "Scan plan overview per session (replaces legacy-scan-plan.md semantically)."
      },
      {
        "path": ".mc-data/work/legacy-scan/sessions/{id}/phase-summary.md",
        "template": "templates/phase-summary.md",
        "required": true,
        "description": "Phase summary tieng Viet (CORE-028)."
      },
      {
        "path": ".mc-data/work/legacy-scan/sessions/{id}/session-log.json",
        "template": null,
        "required": true,
        "notes": "CORE-026 observability — append-only START/COMPLETE/FAIL events."
      },
      {
        "path": ".mc-data/work/legacy-scan/sessions/{id}/session-digest.md",
        "template": "templates/session-digest.md",
        "required": true,
        "description": "Session digest generated at finalize."
      },
      {
        "path": ".mc-data/work/legacy-scan/sessions/{id}/error-ledger.json",
        "template": "templates/error-ledger.json",
        "required": true,
        "description": "Append-only error ledger (session-scoped)."
      },
      {
        "path": ".mc-data/work/legacy-scan/sessions/{id}/events.jsonl",
        "template": null,
        "required": false,
        "notes": "JSONL append-only — agent spawn/complete events."
      },
      {
        "path": ".mc-data/work/legacy-scan/domain-hints.json",
        "template": "templates/domain-hints.json",
        "required": true,
        "description": "NEW v5.0 — IPS output, domain detection signals + confidence (EN + VN)."
      },
      {
        "path": ".mc-data/work/legacy-scan/impact-graph.json",
        "template": "templates/impact-graph.json",
        "required": false,
        "description": "NEW v5.0 — impact graph (ADR-LS14). Generated khi synthesis_mode = full+insights."
      },
      {
        "path": ".mc-data/work/legacy-scan/project-profile.json",
        "template": "templates/project-profile.json",
        "required": true,
        "notes": "Generated by legacy-scan-detect.sh. v5.0 them optional field domain_hints (FK -> domain-hints.json summary)."
      },
      {
        "path": ".mc-data/work/legacy-scan/assessment-report.json",
        "template": "templates/assessment-report.json",
        "required": true,
        "notes": "v5.0 them optional fields: stale_threshold_days, domain_enrichment."
      },
      {
        "path": ".mc-data/work/legacy-scan/ledger.json",
        "template": "templates/ledger.json",
        "required": true,
        "notes": "v2.1 — generated ONCE boi orchestrator tai POST Phase 4 synthesize (read-only legacy projection). Sub-skills KHONG ghi truc tiep. Ref: ADR-LS04 revised, 04-data-model.md §1.3."
      },
      {
        "path": ".mc-data/work/legacy-scan/inventory/*.json",
        "template": null,
        "validation_contract": "templates/legacy-pipeline-contract.json",
        "required": true,
        "description": "Inventory files (8) — unchanged schema: screens, api-endpoints, source-files, dependency-graph, doc-files, external-docs, doc-classified, ui-manifest."
      },
      {
        "path": ".mc-data/work/legacy-scan/project-context.md",
        "template": "templates/project-context.md",
        "required": true,
        "description": "Stage 4 Synthesize output — CORE-021 LEGACY_MODE detection anchor. Content depth varies by synthesis_mode."
      },
      {
        "path": ".mc-data/work/legacy-scan/doc-quality-map.json",
        "template": "templates/doc-quality-map.json",
        "required": true,
        "description": "Doc quality trust map (unchanged v4.1)."
      },
      {
        "path": ".mc-data/work/legacy-scan/impl-status-snapshot.json",
        "template": "templates/impl-status-snapshot.json",
        "required": false,
        "description": "Snapshot impl_status (unchanged v4.1). Skip khi synthesis_mode = condensed."
      },
      {
        "path": ".mc-data/work/legacy-scan/module-code-mapping.json",
        "template": null,
        "required": true,
        "description": "Module-code mapping (CORE-013, unchanged v4.1)."
      },
      {
        "path": ".mc-data/work/legacy-scan/inventory/ui-manifest.json",
        "template": null,
        "required": false,
        "description": "UI manifest — chi tao khi screen_count > 0. Schema ref: templates/inventory/ui-manifest.json.",
        "condition": "Chi tao khi screen_count > 0"
      },
      {
        "path": ".mc-data/work/legacy-scan/workloads/{workload-id}/fix-workload.json",
        "template": "templates/fix-workload.json",
        "required": false,
        "deferred_to": "v5.1",
        "description": "DEFERRED v5.1 — workload partitioning (template hien tai o Phase A6 de pre-wire, logic implement sau)."
      }
    ],
    "registry": null,
    "_notes": "Skill nay co own pipeline contracts tai templates/legacy-scan-contract.json va templates/legacy-pipeline-contract.json. _contract.json nay la skill-level contract theo skill-contract-v1 schema."
  },
  "registry_scope": {
    "role": "NONE",
    "fields_owned": [],
    "safe_write_rule": "CORE-006",
    "notes": "Skill nay KHONG ghi vao req-registry.json. Registry duoc tao/cap nhat boi /wf-design (legacy flow)."
  },
