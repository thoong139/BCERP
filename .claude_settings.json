{
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Read(./**)",
      "Write(./**)",
      "Edit(./**)",
      "Glob(./**)",
      "Grep(./**)",
      "Read(Z:\\Working\\MCV3/**)",
      "Write(Z:\\Working\\MCV3/**)",
      "Edit(Z:\\Working\\MCV3/**)",
      "Glob(Z:\\Working\\MCV3/**)",
      "Grep(Z:\\Working\\MCV3/**)",
      "Read(.mc-data/**)",
      "Write(.mc-data/**)",
      "Edit(.mc-data/**)",
      "Bash(*)",
      "WebFetch(*)",
      "WebSearch(*)",
      "Task(*)",
      "TodoWrite(*)",
      "NotebookEdit(*)",
      "mcp__cc-workflow-studio__*",
      "mcp__mcv3-project-memory__*",
      "mcp__plugin_context7_context7__resolve-library-id",
      "mcp__plugin_context7_context7__query-docs"
    ],
    "deny": [
      "Write(.env)",
      "Write(.env.*)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Write(**/credentials*)",
      "Write(**/secrets*)",
      "Write(**/*.pem)",
      "Write(**/*.key)",
      "Write(.git/**)",
      "Edit(.git/**)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~/)",
      "Bash(rm -rf ~/*)",
      "Bash(dd if=/dev/zero *)",
      "Bash(dd if=/dev/urandom *)",
      "Bash(mkfs *)",
      "Bash(fdisk *)",
      "Write(/etc/**)",
      "Write(/boot/**)",
      "Write(/sys/**)"
    ],
    "additionalDirectories": [
      "Z:\\Working\\MCV3\\.claude",
      "Z:\\Working\\MCV3\\.claude\\doc-framework\\_meta",
      "Z:\\Working\\EUREKA-2026\\.claude\\doc-framework\\phase3-architecture",
      "C:\\Users\\hanoi\\.claude"
    ]
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "MCV3_HOOK_METRICS_ENABLED": "1"
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "cc-workflow-studio",
    "mcv3-project-memory"
  ]
}