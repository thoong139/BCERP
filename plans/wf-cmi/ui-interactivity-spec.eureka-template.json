  "client_specific": {
    "description": "EUREKA-2026 có 3 clients. Mỗi client có endpoint coverage khác nhau.",

    "erp-web": {
      "description": "Internal staff web app (Next.js 16) — full feature",
      "should_consume": [
        "user_facing.**",
        "admin_only.** (chỉ admin role)"
      ]
    },

    "mobile-staff": {
      "description": "Mobile app cho field staff (tracking operators, customs officers)",
      "should_consume": [
        "user_facing.booking.**",
        "user_facing.tracking.**",
        "user_facing.customs.declarations.**"
      ],
      "should_not_consume": [
        "user_facing.invoice.**",
        "user_facing.payment.**",
        "admin_only.**"
      ],
      "_comment": "Staff mobile không quản lý tài chính, không có admin"
    },

    "mobile-customer": {
      "description": "Mobile app cho khách hàng (shipper, consignee)",
      "should_consume": [
        "user_facing.tracking.{bol_id}.**",
        "user_facing.notification.**",
        "user_facing.invoice.{id} (read-only)",
        "user_facing.payment.{id} (read-only)",
        "user_facing.user.profile"
      ],
      "should_not_consume": [
        "user_facing.booking.create",
        "user_facing.customs.**",
        "user_facing.tariff.**",
        "admin_only.**"
      ],
      "_comment": "Customer chỉ track + xem invoice/payment + receive notification"
    }
  },

  "deprecation_tracking": {
