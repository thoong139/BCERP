      },
      {
        "name": "EventLog",
        "rationale": "System-internal, no UI needed"
      },
      {
        "name": "OutboxMessage",
        "rationale": "Infrastructure"
      },
      {
        "name": "MigrationHistory",
        "rationale": "Infrastructure"
      },
      {
        "name": "FeatureFlag",
        "rationale": "Admin-only"
      },
      {
        "name": "Tenant",
        "rationale": "Admin-only, có UI riêng trong /admin/tenant"
      }
    ]
  },

