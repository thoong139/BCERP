  "roles": {
    "description": "10 vai trò chuẩn EUREKA. Mỗi role được grant subset of permissions.",

    "sysadmin": {
      "description": "Super admin — quản trị hệ thống toàn bộ",
      "scope": "global",
      "permissions_granted": "all",
      "_comment": "Sysadmin có ALL permissions kể cả admin/super_admin/global scope"
    },

    "tenant_admin": {
      "description": "Admin tenant — quản trị 1 tenant",
      "scope": "tenant",
      "permissions_granted": [
        "settings.*",
        "compliance.*.read",
        "compliance.audit_log.export"
      ],
      "_comment_excludes": "Không có super_admin permissions, không global scope"
    },

    "finance_manager": {
      "description": "Trưởng phòng tài chính",
      "scope": "tenant",
      "permissions_granted": [
        "finance.*",
        "tax.*",
        "compliance.audit_log.read",
        "bi.dashboard.view",
        "bi.report.create",
        "approval.request.approve (when approval.target=finance)"
