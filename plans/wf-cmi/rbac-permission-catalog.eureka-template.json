  "scopes": {
    "description": "Permission scope types.",
    "tenant": "Per-tenant — row-level security filter by TenantId",
    "global": "Cross-tenant — chỉ sysadmin/super_admin",
    "own": "Own-records only — filter by OwnerId / CustomerId",
    "team": "Team-records — filter by TeamId / DepartmentId"
  },

  "client_coverage_matrix": {
    "description": "Map mỗi client → permission subset expected.",

    "erp-web": {
      "description": "Internal staff web app — full coverage",
      "expected_permissions": "all (theo role)"
    },

    "mobile-staff": {
      "description": "Mobile cho staff (field operators, drivers, customs officers)",
      "expected_permissions": [
        "tms.*",
        "orders.order.read",
        "orders.order.create",
        "wms.inventory.read",
        "wms.shipment.pack",
        "customs.declaration.read",
        "customs.declaration.create",
        "cms.document.upload",
        "approval.*"
      ],
      "excluded_permissions": [
        "finance.*",
        "tax.*",
        "settings.*",
        "compliance.regulation.configure",
        "bi.*"
      ],
