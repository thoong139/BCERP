{
  "$schema": "rbac-permission-catalog-v1",
  "project": "EUREKA-2026",
  "version": "1.0.0-template",
  "last_updated": "2026-05-16",
  "description": "Template SSOT cho CD15 (UI Permission Mirror) + CD38 (UI Implementation Coverage). Catalog đầy đủ 90+ permissions theo format {module}.{resource}.{action}, roles, role-permission mapping, scope (tenant/global), client coverage (erp-web/mobile-customer/mobile-staff). Người chạy /wf-cmi cần copy file này vào .mc-data/docs/_meta/ và điều chỉnh theo thực tế project.",
  "_template_notes": "PHẢI xóa các field bắt đầu bằng _ trước khi commit. Đây là TEMPLATE — không phải runtime config.",

  "_instructions": {
    "how_to_use": "1) Copy file này vào .mc-data/docs/_meta/rbac-permission-catalog.json. 2) Strip metadata fields. 3) Update theo permissions thực tế EUREKA backend (seed file Eureka.Api/Seeders/RoleSeeder.cs hoặc RBAC config). 4) Chạy /wf-cmi --dims=CD15,CD38 để verify.",
    "default_behavior": "Permission KHÔNG declare trong file này → KHÔNG check UI mirror. Permission có UI element nhưng KHÔNG trong catalog → ORPHAN_UI_PERMISSION (severity HIGH).",
    "scope_default": "tenant — nếu không declare scope explicit."
  },

  "config": {
    "permission_format": "{module}.{resource}.{action}",
    "permission_format_regex": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
    "default_scope": "tenant",
    "enforce_ui_mirror": true,
    "enforce_client_coverage": true,
    "_comment_format": "Lowercase, dots separator, snake_case parts.",
    "_comment_mirror": "Mọi permission được grant cho role active PHẢI có UI element corresponding (CD15 check)."
  },

  "modules": {
    "description": "17 EUREKA business modules. Mỗi module có permission namespace riêng.",
    "list": [
      "approval", "bi", "cms", "crm", "compliance", "customs", "finance",
      "hrm", "marketing", "orders", "qc", "quotation", "settings",
      "sourcing", "tax", "tms", "wms"
    ]
  },

