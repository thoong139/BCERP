{
  "$schema": "workflow-state-machines-v1",
  "project": "EUREKA-2026",
  "version": "1.0.0-template",
  "last_updated": "2026-05-16",
  "description": "Template SSOT cho CD3 (Workflow Coverage) + CD26 (UX Workflow Visibility) + CD38 (UI Implementation Coverage). Định nghĩa state machines cho mọi entity có lifecycle: states, transitions, actor, guard rules, terminal states, SLA. Người chạy /wf-cmi cần copy file này vào .mc-data/docs/_meta/ và điều chỉnh theo thực tế project.",
  "_template_notes": "PHẢI xóa các field bắt đầu bằng _ trước khi commit. Đây là TEMPLATE — không phải runtime config.",

  "_instructions": {
    "how_to_use": "1) Copy file này vào .mc-data/docs/_meta/workflow-state-machines.json. 2) Strip metadata fields. 3) Update theo state machines thực tế (xem Domain layer .NET / EF Core). 4) Chạy /wf-cmi --dims=CD3,CD26,CD38 để verify.",
    "default_behavior": "Entity KHÔNG declare state machine → KHÔNG check. Entity declare nhưng thiếu transition trong code → MISSING_TRANSITION (severity HIGH). Code có transition không trong declared → ORPHAN_TRANSITION.",
    "cd26_focus": "CD26 check user visibility: mỗi state PHẢI có UI element show current state (badge, status label, timeline). Mỗi transition PHẢI có UI trigger (button/form) nếu actor=user.",
    "cd38_focus": "CD38 check transitions không có UI trigger → MISSING_UI_TRIGGER (severity CRITICAL)."
  },

  "config": {
    "enforce_terminal_states": true,
    "enforce_no_unreachable_states": true,
    "enforce_actor_declared": true,
    "default_sla_hours": 24,
    "warn_orphan_transitions": true,
    "_comment_terminal": "Mỗi workflow PHẢI có ≥1 terminal state (success + failure).",
    "_comment_unreachable": "State không có transition vào → UNREACHABLE_STATE (lỗi design)."
  },

  "state_machines": {
    "description": "State machine per entity.",

    "Booking": {
      "owner_module": "TMS",
      "entity": "Booking (Bill of Lading)",
      "description": "Booking lifecycle từ tạo → giao hàng. 7 states.",
      "initial_state": "draft",
      "terminal_states": ["delivered_confirmed", "cancelled"],
      "states": [
        {"name": "draft", "label_vi": "Nháp", "color": "gray", "kind": "intermediate"},
        {"name": "submitted_for_carrier", "label_vi": "Đang chờ hãng tàu xác nhận", "color": "yellow", "kind": "intermediate", "sla_hours": 24},
        {"name": "requires_carrier_confirmation", "label_vi": "Cần xác nhận thủ công", "color": "orange", "kind": "intermediate", "recovery": true, "_comment": "Khi carrier API timeout >24h"},
        {"name": "carrier_confirmed", "label_vi": "Hãng tàu đã xác nhận", "color": "blue", "kind": "intermediate"},
        {"name": "in_transit", "label_vi": "Đang vận chuyển", "color": "blue", "kind": "intermediate", "sla_hours": 168},
        {"name": "delivered_pending_confirm", "label_vi": "Đã giao - chờ xác nhận", "color": "yellow", "kind": "intermediate", "sla_hours": 48},
        {"name": "delivered_confirmed", "label_vi": "Đã giao - xác nhận", "color": "green", "kind": "terminal_success"},
        {"name": "cancelled", "label_vi": "Đã hủy", "color": "red", "kind": "terminal_failure"}
      ],
      "transitions": [
        {"id": "T1", "from": "draft", "to": "submitted_for_carrier", "actor": "user", "permission": "tms.booking.create", "ui_button": "Gửi cho hãng tàu xác nhận", "ui_location": "/booking/[id]"},
        {"id": "T2", "from": "submitted_for_carrier", "to": "carrier_confirmed", "actor": "system", "trigger": "carrier_webhook_confirmed", "_comment": "Auto khi carrier callback"},
        {"id": "T3", "from": "submitted_for_carrier", "to": "requires_carrier_confirmation", "actor": "system", "trigger": "timeout_24h", "_comment": "Auto khi timeout"},
        {"id": "T4", "from": "requires_carrier_confirmation", "to": "carrier_confirmed", "actor": "user", "permission": "tms.booking.confirm_carrier", "ui_button": "Xác nhận thủ công (carrier chậm)", "ui_location": "/booking/[id]", "manager_role": true, "requires_reason": true},
        {"id": "T5", "from": "carrier_confirmed", "to": "in_transit", "actor": "system", "trigger": "shipment_picked_up_event"},
        {"id": "T6", "from": "in_transit", "to": "delivered_pending_confirm", "actor": "user", "permission": "tms.shipment.tracking_update", "ui_button": "Cập nhật trạng thái: Đã giao", "ui_location": "/tracking/[bol_id]"},
        {"id": "T7", "from": "delivered_pending_confirm", "to": "delivered_confirmed", "actor": "user", "permission": "tms.booking.read", "ui_button": "Xác nhận giao hàng", "ui_location": "/tracking/[bol_id]", "client": "mobile-customer + erp-web"},
        {"id": "T8", "from": "delivered_pending_confirm", "to": "delivered_confirmed", "actor": "system", "trigger": "auto_confirm_after_48h"},
        {"id": "T9", "from": "draft", "to": "cancelled", "actor": "user", "permission": "tms.booking.create", "ui_button": "Xóa nháp", "ui_location": "/booking/[id]"},
        {"id": "T10", "from": "submitted_for_carrier", "to": "cancelled", "actor": "user", "permission": "tms.booking.create", "ui_button": "Hủy booking", "ui_location": "/booking/[id]", "requires_reason": true, "requires_confirmation": true}
      ],
      "events_published": [
        "tms.booking.created", "tms.booking.cancelled", "tms.shipment.picked_up", "tms.shipment.delivered"
      ]
    },

    "CustomsDeclaration": {
      "owner_module": "Customs",
      "entity": "CustomsDeclaration (VN VNACCS hoặc CN H2010)",
      "description": "Tờ khai hải quan lifecycle. 6 states.",
      "initial_state": "draft",
      "terminal_states": ["approved_pending_pickup", "released", "cancelled"],
      "states": [
        {"name": "draft", "label_vi": "Nháp", "color": "gray", "kind": "intermediate"},
        {"name": "submitted", "label_vi": "Đã gửi cơ quan HQ", "color": "yellow", "kind": "intermediate", "sla_hours": 4},
        {"name": "rejected", "label_vi": "Bị từ chối", "color": "red", "kind": "intermediate", "must_show_rejection_reason": true},
        {"name": "pending_payment", "label_vi": "Chờ thanh toán thuế", "color": "orange", "kind": "intermediate", "sla_hours": 72},
        {"name": "approved_pending_pickup", "label_vi": "Đã duyệt - chờ lấy hàng", "color": "blue", "kind": "intermediate"},
        {"name": "released", "label_vi": "Đã thông quan", "color": "green", "kind": "terminal_success"},
        {"name": "cancelled", "label_vi": "Đã hủy", "color": "red", "kind": "terminal_failure"}
      ],
      "transitions": [
        {"id": "T1", "from": "draft", "to": "submitted", "actor": "user", "permission": "customs.declaration.submit", "ui_button": "Gửi cơ quan hải quan", "ui_location": "/customs/declarations/[id]", "requires_confirmation": true},
        {"id": "T2", "from": "submitted", "to": "rejected", "actor": "system", "trigger": "vnaccs_rejection_webhook"},
        {"id": "T3", "from": "submitted", "to": "pending_payment", "actor": "system", "trigger": "vnaccs_pending_payment_webhook"},
        {"id": "T4", "from": "rejected", "to": "submitted", "actor": "user", "permission": "customs.declaration.update", "ui_button": "Sửa và gửi lại", "ui_location": "/customs/declarations/[id]/edit", "must_preserve_form_data": true},
        {"id": "T5", "from": "pending_payment", "to": "approved_pending_pickup", "actor": "system", "trigger": "tax_payment_confirmed"},
        {"id": "T6", "from": "approved_pending_pickup", "to": "released", "actor": "user", "permission": "customs.declaration.read", "ui_button": "Xác nhận đã lấy hàng", "ui_location": "/customs/declarations/[id]"},
        {"id": "T7", "from": "draft", "to": "cancelled", "actor": "user", "permission": "customs.declaration.update"},
        {"id": "T8", "from": "submitted", "to": "cancelled", "actor": "user", "permission": "customs.declaration.amendment", "manager_role": true, "requires_reason": true, "compliance_tags": ["VN-VNACCS"]}
      ],
      "events_published": ["customs.declaration.submitted", "customs.declaration.released", "customs.declaration.cancelled"]
    },

    "Invoice": {
      "owner_module": "Finance",
      "entity": "Invoice (HĐĐT TT78/2021)",
      "description": "Invoice lifecycle. Immutable sau khi issue.",
      "initial_state": "draft",
      "terminal_states": ["fully_paid", "cancelled_credit_note"],
      "states": [
        {"name": "draft", "label_vi": "Nháp", "color": "gray", "kind": "intermediate"},
        {"name": "issued_pending_tax_authority", "label_vi": "Đã phát hành - chờ cơ quan thuế", "color": "yellow", "kind": "intermediate", "sla_hours": 24, "compliance_tags": ["VN-TT78-eInvoice"]},
        {"name": "issued_verified", "label_vi": "Đã có mã CQT", "color": "blue", "kind": "intermediate", "immutable": true},
        {"name": "partially_paid", "label_vi": "Thanh toán một phần", "color": "orange", "kind": "intermediate"},
        {"name": "fully_paid", "label_vi": "Đã thanh toán đủ", "color": "green", "kind": "terminal_success"},
        {"name": "overdue", "label_vi": "Quá hạn", "color": "red", "kind": "intermediate"},
        {"name": "cancelled_credit_note", "label_vi": "Đã hủy bằng HĐ điều chỉnh", "color": "red", "kind": "terminal_failure", "_comment": "Không xóa, chỉ credit note"}
      ],
      "transitions": [
        {"id": "T1", "from": "draft", "to": "issued_pending_tax_authority", "actor": "user", "permission": "finance.invoice.issue", "ui_button": "Phát hành hóa đơn", "ui_location": "/invoice/[id]", "manager_role": true, "irreversible": true, "requires_confirmation": true, "compliance_tags": ["VN-TT78-eInvoice"]},
        {"id": "T2", "from": "issued_pending_tax_authority", "to": "issued_verified", "actor": "system", "trigger": "tax_authority_webhook_verified"},
        {"id": "T3", "from": "issued_verified", "to": "partially_paid", "actor": "system", "trigger": "payment_received_partial"},
        {"id": "T4", "from": "issued_verified", "to": "fully_paid", "actor": "system", "trigger": "payment_received_full"},
        {"id": "T5", "from": "partially_paid", "to": "fully_paid", "actor": "system", "trigger": "payment_received_remaining"},
        {"id": "T6", "from": "issued_verified", "to": "overdue", "actor": "system", "trigger": "due_date_passed_unpaid"},
        {"id": "T7", "from": "issued_verified", "to": "cancelled_credit_note", "actor": "user", "permission": "finance.invoice.credit_note", "ui_button": "Tạo hóa đơn điều chỉnh", "ui_location": "/invoice/[id]", "manager_role": true, "_comment": "Tạo credit note → đánh dấu invoice gốc cancelled"},
        {"id": "T8", "from": "draft", "to": "cancelled_credit_note", "actor": "user", "permission": "finance.invoice.cancel", "ui_button": "Hủy nháp", "_comment": "Draft cancel — không tạo credit note"}
      ],
      "events_published": ["finance.invoice.issued", "finance.invoice.paid", "finance.invoice.credit_noted"]
    },

    "Order": {
      "owner_module": "Orders",
      "entity": "SalesOrder",
      "description": "Order lifecycle.",
      "initial_state": "draft",
      "terminal_states": ["fulfilled", "cancelled"],
      "states": [
        {"name": "draft", "label_vi": "Nháp", "kind": "intermediate"},
        {"name": "confirmed", "label_vi": "Đã xác nhận", "kind": "intermediate"},
        {"name": "in_progress", "label_vi": "Đang xử lý", "kind": "intermediate"},
        {"name": "ready_to_ship", "label_vi": "Sẵn sàng giao", "kind": "intermediate"},
        {"name": "shipped", "label_vi": "Đã giao cho TMS", "kind": "intermediate"},
        {"name": "fulfilled", "label_vi": "Hoàn tất", "kind": "terminal_success"},
        {"name": "cancelled", "label_vi": "Đã hủy", "kind": "terminal_failure"}
      ],
      "transitions": [
        {"id": "T1", "from": "draft", "to": "confirmed", "actor": "user", "permission": "orders.order.confirm", "ui_button": "Xác nhận đơn", "ui_location": "/order/[id]"},
        {"id": "T2", "from": "confirmed", "to": "in_progress", "actor": "system", "trigger": "wms_picking_started"},
        {"id": "T3", "from": "in_progress", "to": "ready_to_ship", "actor": "system", "trigger": "wms_packing_completed"},
        {"id": "T4", "from": "ready_to_ship", "to": "shipped", "actor": "system", "trigger": "tms_booking_created"},
        {"id": "T5", "from": "shipped", "to": "fulfilled", "actor": "system", "trigger": "tms_shipment_delivered + invoice_fully_paid"},
        {"id": "T6", "from": "draft", "to": "cancelled", "actor": "user", "permission": "orders.order.cancel", "ui_button": "Xóa đơn"},
        {"id": "T7", "from": "confirmed", "to": "cancelled", "actor": "user", "permission": "orders.order.cancel", "ui_button": "Hủy đơn", "requires_reason": true, "requires_confirmation": true}
      ]
    },

    "Quotation": {
      "owner_module": "Quotation",
      "entity": "Quotation (báo giá)",
      "description": "Quotation lifecycle.",
      "initial_state": "draft",
      "terminal_states": ["converted_to_order", "expired", "rejected"],
      "states": [
        {"name": "draft", "label_vi": "Nháp", "kind": "intermediate"},
        {"name": "pending_internal_approval", "label_vi": "Chờ duyệt nội bộ", "kind": "intermediate", "_comment": "Khi discount >10%"},
        {"name": "approved_internal", "label_vi": "Đã duyệt nội bộ", "kind": "intermediate"},
        {"name": "sent_to_customer", "label_vi": "Đã gửi KH", "kind": "intermediate", "sla_hours": 720},
        {"name": "accepted", "label_vi": "KH chấp thuận", "kind": "intermediate"},
        {"name": "rejected", "label_vi": "KH từ chối", "kind": "terminal_failure"},
        {"name": "expired", "label_vi": "Hết hạn", "kind": "terminal_failure"},
        {"name": "converted_to_order", "label_vi": "Chuyển thành đơn", "kind": "terminal_success"}
      ],
      "transitions": [
        {"id": "T1", "from": "draft", "to": "pending_internal_approval", "actor": "user", "permission": "quotation.quote.send", "guard": "discount_percent > 10", "ui_button": "Gửi duyệt"},
        {"id": "T2", "from": "draft", "to": "sent_to_customer", "actor": "user", "permission": "quotation.quote.send", "guard": "discount_percent <= 10", "ui_button": "Gửi báo giá"},
        {"id": "T3", "from": "pending_internal_approval", "to": "approved_internal", "actor": "user", "permission": "quotation.quote.approve_discount", "ui_button": "Duyệt", "manager_role": true},
        {"id": "T4", "from": "approved_internal", "to": "sent_to_customer", "actor": "user", "permission": "quotation.quote.send", "ui_button": "Gửi báo giá"},
        {"id": "T5", "from": "sent_to_customer", "to": "accepted", "actor": "user", "permission": "quotation.quote.send", "ui_button": "Đánh dấu đã chấp thuận"},
        {"id": "T6", "from": "sent_to_customer", "to": "rejected", "actor": "user", "permission": "quotation.quote.send", "ui_button": "Đánh dấu từ chối", "requires_reason": true},
        {"id": "T7", "from": "sent_to_customer", "to": "expired", "actor": "system", "trigger": "valid_until_passed"},
        {"id": "T8", "from": "accepted", "to": "converted_to_order", "actor": "user", "permission": "quotation.quote.convert_to_order", "ui_button": "Chuyển thành đơn", "ui_location": "/quotation/[id]"}
      ]
    },

    "Payment": {
      "owner_module": "Finance",
      "entity": "Payment",
      "initial_state": "pending",
      "terminal_states": ["confirmed", "failed", "refunded"],
      "states": [
        {"name": "pending", "label_vi": "Đang chờ", "kind": "intermediate", "sla_hours": 72},
        {"name": "processing", "label_vi": "Đang xử lý", "kind": "intermediate"},
        {"name": "confirmed", "label_vi": "Xác nhận", "kind": "terminal_success"},
        {"name": "failed", "label_vi": "Thất bại", "kind": "intermediate", "_comment": "Có thể retry"},
        {"name": "refunded", "label_vi": "Đã hoàn", "kind": "terminal_failure"}
      ],
      "transitions": [
        {"id": "T1", "from": "pending", "to": "processing", "actor": "system", "trigger": "payment_gateway_processing"},
        {"id": "T2", "from": "processing", "to": "confirmed", "actor": "system", "trigger": "payment_gateway_success"},
        {"id": "T3", "from": "processing", "to": "failed", "actor": "system", "trigger": "payment_gateway_failure"},
        {"id": "T4", "from": "failed", "to": "pending", "actor": "user", "permission": "finance.payment.create", "ui_button": "Thử lại"},
        {"id": "T5", "from": "pending", "to": "confirmed", "actor": "user", "permission": "finance.payment.create", "ui_button": "Xác nhận thủ công (đã nhận tiền)", "manager_role": true, "requires_reason": true, "_comment": "Manual confirm khi nhận tiền mặt/chuyển khoản"},
        {"id": "T6", "from": "confirmed", "to": "refunded", "actor": "user", "permission": "finance.payment.refund", "ui_button": "Hoàn tiền", "manager_role": true, "requires_confirmation": true}
      ]
    },

    "ApprovalRequest": {
      "owner_module": "Approval",
      "entity": "ApprovalRequest (generic approval workflow)",
      "initial_state": "pending",
      "terminal_states": ["approved", "rejected", "cancelled"],
      "states": [
        {"name": "pending", "label_vi": "Đang chờ duyệt", "kind": "intermediate"},
        {"name": "in_review", "label_vi": "Đang xem xét", "kind": "intermediate"},
        {"name": "approved", "label_vi": "Đã duyệt", "kind": "terminal_success"},
        {"name": "rejected", "label_vi": "Từ chối", "kind": "terminal_failure"},
        {"name": "cancelled", "label_vi": "Đã hủy yêu cầu", "kind": "terminal_failure"}
      ],
      "transitions": [
        {"id": "T1", "from": "pending", "to": "in_review", "actor": "user", "permission": "approval.request.approve", "_comment": "Khi approver mở để xem"},
        {"id": "T2", "from": "in_review", "to": "approved", "actor": "user", "permission": "approval.request.approve", "ui_button": "Duyệt", "requires_confirmation": true},
        {"id": "T3", "from": "in_review", "to": "rejected", "actor": "user", "permission": "approval.request.reject", "ui_button": "Từ chối", "requires_reason": true},
        {"id": "T4", "from": "pending", "to": "cancelled", "actor": "user", "permission": "approval.request.create", "_comment": "Người tạo có thể cancel khi pending"}
      ]
    },

    "PurchaseOrder": {
      "owner_module": "Sourcing",
      "entity": "PurchaseOrder",
      "initial_state": "draft",
      "terminal_states": ["completed", "cancelled"],
      "states": [
        {"name": "draft", "label_vi": "Nháp", "kind": "intermediate"},
        {"name": "pending_approval", "label_vi": "Chờ duyệt", "kind": "intermediate"},
        {"name": "approved", "label_vi": "Đã duyệt", "kind": "intermediate"},
        {"name": "sent_to_vendor", "label_vi": "Đã gửi NCC", "kind": "intermediate"},
        {"name": "partially_received", "label_vi": "Nhận một phần", "kind": "intermediate"},
        {"name": "fully_received", "label_vi": "Nhận đủ", "kind": "intermediate"},
        {"name": "completed", "label_vi": "Hoàn tất", "kind": "terminal_success"},
        {"name": "cancelled", "label_vi": "Đã hủy", "kind": "terminal_failure"}
      ],
      "transitions": [
        {"id": "T1", "from": "draft", "to": "pending_approval", "actor": "user", "permission": "sourcing.po.create", "ui_button": "Gửi duyệt"},
        {"id": "T2", "from": "pending_approval", "to": "approved", "actor": "user", "permission": "sourcing.po.approve", "ui_button": "Duyệt"},
        {"id": "T3", "from": "approved", "to": "sent_to_vendor", "actor": "user", "permission": "sourcing.po.create", "ui_button": "Gửi NCC"},
        {"id": "T4", "from": "sent_to_vendor", "to": "partially_received", "actor": "system", "trigger": "wms_partial_receipt"},
        {"id": "T5", "from": "partially_received", "to": "fully_received", "actor": "system", "trigger": "wms_full_receipt"},
        {"id": "T6", "from": "sent_to_vendor", "to": "fully_received", "actor": "system", "trigger": "wms_full_receipt"},
        {"id": "T7", "from": "fully_received", "to": "completed", "actor": "system", "trigger": "vendor_invoice_paid"}
      ]
    },

    "QcInspection": {
      "owner_module": "QC",
      "entity": "QcInspection (kiểm tra chất lượng)",
      "initial_state": "scheduled",
      "terminal_states": ["passed", "failed_quarantined"],
      "states": [
        {"name": "scheduled", "label_vi": "Đã lên lịch", "kind": "intermediate"},
        {"name": "in_progress", "label_vi": "Đang kiểm tra", "kind": "intermediate"},
        {"name": "passed", "label_vi": "Đạt", "kind": "terminal_success"},
        {"name": "failed_quarantined", "label_vi": "Không đạt - đã cách ly", "kind": "terminal_failure"}
      ],
      "transitions": [
        {"id": "T1", "from": "scheduled", "to": "in_progress", "actor": "user", "permission": "qc.inspection.create", "ui_button": "Bắt đầu kiểm tra"},
        {"id": "T2", "from": "in_progress", "to": "passed", "actor": "user", "permission": "qc.inspection.complete", "ui_button": "Đánh dấu Đạt", "requires_confirmation": true},
        {"id": "T3", "from": "in_progress", "to": "failed_quarantined", "actor": "user", "permission": "qc.inspection.complete", "ui_button": "Đánh dấu Không đạt", "requires_reason": true, "requires_confirmation": true}
      ]
    }
  },

  "ux_visibility_requirements": {
    "description": "CD26 — UX Workflow Visibility. Mỗi state machine PHẢI hiển thị cho user.",
    "requirements": [
      {
        "id": "UX-VIS-001",
        "rule": "Mỗi entity có state machine → list page PHẢI có status badge column",
        "ui_pattern": "<StatusBadge state={entity.status} machine='Booking' />",
        "severity": "HIGH"
      },
      {
        "id": "UX-VIS-002",
        "rule": "Detail page PHẢI có timeline hiển thị state history",
        "ui_pattern": "<StateTimeline transitions={entity.transitionHistory} />",
        "severity": "HIGH"
      },
      {
        "id": "UX-VIS-003",
        "rule": "Mỗi transition có actor=user PHẢI có UI button visible (theo permission)",
        "severity": "CRITICAL"
      },
      {
        "id": "UX-VIS-004",
        "rule": "State có SLA → countdown hoặc warning khi gần due",
        "severity": "MEDIUM"
      },
      {
        "id": "UX-VIS-005",
        "rule": "State 'rejected' → must_show_rejection_reason=true → UI PHẢI hiển thị reason rõ ràng",
        "severity": "HIGH"
      },
      {
        "id": "UX-VIS-006",
        "rule": "Transition irreversible=true → confirmation dialog warning",
        "severity": "HIGH"
      }
    ]
  },

  "validation_rules": {
    "description": "Top-level rules cho CD3 + CD26 + CD38.",
    "rules": [
      {
        "id": "RULE-CD3-001",
        "name": "every_entity_has_initial_state",
        "description": "State machine PHẢI có initial_state declared",
        "severity": "CRITICAL"
      },
      {
        "id": "RULE-CD3-002",
        "name": "every_entity_has_terminal_state",
        "description": "State machine PHẢI có ≥1 terminal_state",
        "severity": "CRITICAL"
      },
      {
        "id": "RULE-CD3-003",
        "name": "no_unreachable_states",
        "description": "Mọi state non-initial PHẢI có ≥1 transition vào nó",
        "severity": "HIGH"
      },
      {
        "id": "RULE-CD3-004",
        "name": "transitions_match_code",
        "description": "Transitions declared PHẢI match code implementations (Domain layer). Code có transition không declare → ORPHAN_TRANSITION. Declare nhưng code thiếu → MISSING_TRANSITION.",
        "severity": "CRITICAL"
      },
      {
        "id": "RULE-CD26-001",
        "name": "user_actor_has_ui_button",
        "description": "Transition actor=user PHẢI có ui_button + ui_location declared",
        "severity": "CRITICAL"
      },
      {
        "id": "RULE-CD26-002",
        "name": "states_have_label_vi",
        "description": "State PHẢI có label_vi (tiếng Việt) hiển thị user",
        "severity": "HIGH"
      },
      {
        "id": "RULE-CD38-001",
        "name": "ui_trigger_implemented",
        "description": "Mọi ui_button declared PHẢI có FE implementation (component + handler)",
        "severity": "CRITICAL"
      }
    ]
  },

  "exclusions": {
    "description": "Entities/transitions explicitly excluded.",
    "entity_exclusions": [
      {"entity": "AuditLog", "reason": "Immutable, no state machine"},
      {"entity": "EventLog", "reason": "Infrastructure"},
      {"entity": "Notification", "reason": "Simple state (read/unread) — không cần CD3"}
    ]
  },

