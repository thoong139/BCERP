  "recovery_actions": {
    "description": "Định nghĩa recovery actions chuẩn.",

    "fix_input": {
      "description": "User sửa input + retry",
      "ui_pattern": "inline_field_error",
      "auto_retry": false
    },

    "fix_and_resubmit": {
      "description": "User sửa form + submit lại, giữ data trước đó",
      "ui_pattern": "panel_error_with_form_preserved",
      "must_preserve_form_data": true,
      "auto_retry": false
    },

    "retry_manual": {
      "description": "User click button retry",
      "ui_pattern": "toast_with_retry_button",
      "auto_retry": false
    },

    "retry_with_backoff": {
      "description": "System auto retry với exponential backoff",
      "auto_retry": true,
      "retry_max": 3,
      "retry_backoff_seconds": [1, 5, 15]
    },

    "auto_retry_with_status_update": {
      "description": "System tự retry + update entity status để user theo dõi",
      "auto_retry": true,
      "ui_pattern": "status_badge_pending_retry"
    },

    "wait_and_retry": {
      "description": "User đợi countdown rồi retry",
      "ui_pattern": "snackbar_countdown",
      "auto_retry": false
    },

    "login_again": {
      "description": "Redirect login",
      "ui_pattern": "modal_login_redirect",
      "preserve_url_for_redirect": true
    },

    "contact_admin": {
      "description": "Hiển thị contact link admin tenant",
      "ui_pattern": "modal_with_admin_contact"
    },

    "contact_support": {
      "description": "Liên hệ support EUREKA + kèm correlation_id",
      "ui_pattern": "modal_with_support_link",
      "must_include_correlation_id": true
    },

    "navigate_to_existing": {
      "description": "Navigate tới resource đã có",
      "ui_pattern": "modal_with_navigate_button"
    },

    "user_decision_required": {
      "description": "Hiển thị options cho user chọn",
      "ui_pattern": "modal_with_action_choices"
    },

    "reload_and_retry": {
      "description": "Reload form từ server + retry",
      "ui_pattern": "modal_conflict_resolution"
    },

    "save_draft_and_retry": {
      "description": "Save state local + retry sau",
      "auto_retry": true,
      "ui_pattern": "toast_with_draft_saved_notice"
    },

    "fallback_manual": {
      "description": "Fallback sang flow thủ công",
      "ui_pattern": "modal_with_fallback_option"
    },

    "degraded_mode_continue": {
      "description": "Tiếp tục với degraded mode (warning bar)",
      "ui_pattern": "page_top_warning_bar"
    },

    "transition_to_manual_state": {
      "description": "Move entity tới state require manual user action",
      "ui_pattern": "status_badge_with_action"
    },

    "request_approval": {
      "description": "Tạo approval request",
      "ui_pattern": "modal_with_approval_request_form"
    }
  },

  "ui_patterns": {
    "description": "UI rendering patterns cho mỗi loại error.",

    "inline_field_error": {
      "component": "<FieldError />",
      "location": "Below field",
      "color": "red-500",
      "icon": "alert-circle"
    },

    "toast_error": {
      "component": "<Toast variant='error' />",
      "location": "Top-right",
      "duration_seconds": 5,
      "color": "red-500"
    },

    "toast_warning_with_retry": {
      "component": "<Toast variant='warning' action='retry' />",
      "duration_seconds": 8,
      "color": "yellow-500"
    },

    "modal_error": {
      "component": "<Dialog variant='error' />",
      "blocking": true,
      "color": "red-500"
    },

    "modal_conflict_resolution": {
      "component": "<ConflictDialog />",
      "blocking": true,
      "show_diff": true
    },

    "modal_login_redirect": {
      "component": "<LoginRedirectDialog />",
      "blocking": true,
      "auto_dismiss_after_login": true
    },

    "panel_compliance_error_with_steps": {
      "component": "<CompliancePanel />",
      "location": "Top of form",
      "show_steps": true,
      "color": "red-500"
    },

    "snackbar_with_retry": {
      "component": "<Snackbar action='retry' />",
      "location": "Bottom"
    },

    "snackbar_countdown": {
      "component": "<SnackbarCountdown />",
      "location": "Bottom",
      "show_countdown": true
    },

    "status_badge_pending_retry": {
      "component": "<StatusBadge status='pending-retry' />",
      "show_attempt_count": true
    },

    "page_top_warning_bar": {
      "component": "<WarningBar />",
      "location": "Top of page",
      "color": "yellow-100"
    }
  },

  "validation_rules": {
    "description": "Top-level rules cho CD39.",
    "rules": [
      {
        "id": "RULE-CD39-001",
        "name": "error_code_format_valid",
        "description": "Error code PHẢI match regex format",
        "severity": "CRITICAL"
      },
      {
        "id": "RULE-CD39-002",
        "name": "every_thrown_error_in_catalog",
        "description": "Mọi error code backend ném ra PHẢI có entry trong catalog. Không có → ORPHAN_ERROR",
        "severity": "HIGH"
      },
      {
        "id": "RULE-CD39-003",
        "name": "vi_message_required",
        "description": "Mọi error code PHẢI có message_vi (tiếng Việt)",
        "severity": "CRITICAL"
      },
      {
        "id": "RULE-CD39-004",
        "name": "recovery_action_declared",
        "description": "Mọi error code PHẢI có recovery_action declared",
        "severity": "HIGH"
      },
      {
        "id": "RULE-CD39-005",
        "name": "fe_handler_implemented",
        "description": "Error code có ui_pattern declared → FE PHẢI có component implementation tương ứng",
        "severity": "HIGH"
      },
      {
        "id": "RULE-CD39-006",
        "name": "must_preserve_form_data_implemented",
        "description": "Error có must_preserve_form_data=true → FE handler PHẢI restore form values từ local state",
        "severity": "CRITICAL"
      },
      {
        "id": "RULE-CD39-007",
        "name": "correlation_id_logged",
        "description": "Error có must_include_correlation_id=true → response PHẢI có correlation_id field",
        "severity": "HIGH"
      },
      {
