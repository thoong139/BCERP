{
  "$schema": "error-code-catalog-v1",
  "project": "EUREKA-2026",
  "version": "1.0.0-template",
  "last_updated": "2026-05-16",
  "description": "Template SSOT cho CD39 (Error UX & Recovery). Map error code → message tiếng Việt + recovery action + UI presentation + retry policy. Mọi error backend ném ra PHẢI có entry trong catalog này. Người chạy /wf-cmi cần copy file này vào .mc-data/docs/_meta/ và điều chỉnh theo thực tế project.",
  "_template_notes": "PHẢI xóa các field bắt đầu bằng _ trước khi commit. Đây là TEMPLATE — không phải runtime config.",

  "_instructions": {
    "how_to_use": "1) Copy file này vào .mc-data/docs/_meta/error-code-catalog.json. 2) Strip metadata. 3) Update theo errors backend ném ra (Result<T> pattern + exception types). 4) Chạy /wf-cmi --dims=CD39 để verify.",
    "default_behavior": "Error code KHÔNG declare → backend trả raw exception message (xấu cho user). Frontend KHÔNG có UX recovery cho error đó. → ORPHAN_ERROR (severity HIGH).",
    "code_format": "Format chuẩn: {MODULE}_{CATEGORY}_{NUMBER}. Ví dụ: CRM_VALIDATION_001, FINANCE_TAX_AUTHORITY_TIMEOUT, TMS_CARRIER_TIMEOUT."
  },

  "config": {
    "error_code_format": "{MODULE}_{CATEGORY}_{NUMBER}",
    "error_code_regex": "^[A-Z][A-Z_]+_[A-Z][A-Z_]+_\\d{3,4}$",
    "default_severity": "ERROR",
    "default_recovery_action": "contact_support",
    "default_retry_max": 3,
    "default_retry_backoff_seconds": [1, 5, 15],
    "require_vi_message": true,
    "require_recovery_action": true,
    "_comment_format": "MODULE = uppercase module name (CRM, FINANCE, TMS...). CATEGORY = VALIDATION, BUSINESS, EXTERNAL, NETWORK, AUTH..."
  },

  "categories": {
    "description": "Error categories với UX presentation pattern.",

    "VALIDATION": {
      "description": "Lỗi validation input (form, query)",
      "default_ui_pattern": "inline_field_error",
      "default_severity": "WARN",
      "default_recovery": "fix_input",
      "_comment": "Hiển thị inline dưới field bị lỗi"
    },

    "BUSINESS": {
      "description": "Lỗi business rule (vd: invoice cannot edit after issue)",
      "default_ui_pattern": "modal_error",
      "default_severity": "ERROR",
      "default_recovery": "user_decision_required",
      "_comment": "Modal blocking, giải thích lý do + suggest alternative"
    },

    "AUTHORIZATION": {
      "description": "Lỗi RBAC (permission denied)",
      "default_ui_pattern": "toast_error_with_redirect",
      "default_severity": "ERROR",
      "default_recovery": "contact_admin",
      "_comment": "Toast + redirect tới page có quyền"
    },

    "AUTHENTICATION": {
      "description": "Lỗi auth (session expired, invalid token)",
      "default_ui_pattern": "modal_login_redirect",
      "default_severity": "ERROR",
      "default_recovery": "login_again"
    },

    "EXTERNAL_SERVICE": {
      "description": "Lỗi external API (carrier, customs, payment gateway, tax authority)",
      "default_ui_pattern": "toast_warning_with_retry",
      "default_severity": "WARN",
      "default_recovery": "retry_with_backoff",
      "_comment": "Thường transient — auto retry trước khi báo user"
    },

    "NETWORK": {
      "description": "Lỗi mạng (offline, timeout, DNS)",
      "default_ui_pattern": "snackbar_with_retry",
      "default_severity": "WARN",
      "default_recovery": "retry_manual",
      "_comment": "Đặc biệt cho mobile-staff offline mode"
    },

    "DATA_CONFLICT": {
      "description": "Concurrent modification (optimistic locking)",
      "default_ui_pattern": "modal_conflict_resolution",
      "default_severity": "WARN",
      "default_recovery": "reload_and_retry"
    },

    "RATE_LIMIT": {
      "description": "Rate limit exceeded",
      "default_ui_pattern": "toast_warning_with_countdown",
      "default_severity": "WARN",
      "default_recovery": "wait_and_retry"
    },

    "INFRASTRUCTURE": {
      "description": "Lỗi infrastructure (DB down, cache miss, queue full)",
      "default_ui_pattern": "modal_system_error",
      "default_severity": "CRITICAL",
      "default_recovery": "contact_support"
    },

    "COMPLIANCE": {
      "description": "Lỗi compliance block (vd: tờ khai bị reject by VNACCS)",
      "default_ui_pattern": "panel_compliance_error_with_steps",
      "default_severity": "ERROR",
      "default_recovery": "fix_and_resubmit",
      "_comment": "Hiển thị reason + action steps rõ ràng"
    }
  },

