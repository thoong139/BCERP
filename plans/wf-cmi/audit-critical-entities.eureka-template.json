{
  "$schema": "audit-critical-entities-v1",
  "project": "EUREKA-2026",
  "version": "1.0.0-template",
  "last_updated": "2026-05-16",
  "description": "Template SSOT cho CD29 (Audit Trail Completeness). Định nghĩa entities cần audit trail bắt buộc, fields cần track, retention period, immutability rules, access log. Compliance-driven (VN-PDPL, VN-TT78, GDPR). Người chạy /wf-cmi cần copy file này vào .mc-data/docs/_meta/ và điều chỉnh theo thực tế project.",
  "_template_notes": "PHẢI xóa các field bắt đầu bằng _ trước khi commit. Đây là TEMPLATE — không phải runtime config.",

  "_instructions": {
    "how_to_use": "1) Copy file này vào .mc-data/docs/_meta/audit-critical-entities.json. 2) Strip metadata fields. 3) Update theo entities EUREKA cần audit. 4) Chạy /wf-cmi --dims=CD29 để verify.",
    "default_behavior": "Entity KHÔNG declare → KHÔNG check audit trail. Entity declare nhưng code KHÔNG có AuditLog table corresponding → AUDIT_TRAIL_MISSING (severity CRITICAL).",
    "retention_default": "audit log retain 10 năm cho compliance (TT78), 7 năm cho operations, 3 năm cho behavioral logs."
  },

  "config": {
    "default_retention_years": 7,
    "enforce_immutability": true,
    "require_actor_tracking": true,
    "require_timestamp_utc": true,
    "require_correlation_id": true,
    "max_audit_query_seconds": 5,
    "_comment_immutability": "Audit log entries KHÔNG được UPDATE hoặc DELETE — append-only.",
    "_comment_actor": "Mọi audit entry PHẢI có ActorUserId (NULL = system, ghi rõ in log).",
    "_comment_correlation": "Mọi entry phải có CorrelationId để trace cross-module."
  },

  "audit_critical_entities": {
    "description": "Entities có thay đổi PHẢI ghi audit log đầy đủ.",

    "Customer": {
      "owner_module": "CRM",
      "audit_table": "crm.audit_customer_log",
      "audit_required_actions": ["CREATE", "UPDATE", "DELETE", "PII_READ", "PII_EXPORT", "PII_ERASURE"],
      "tracked_fields": [
        "Name", "TaxCode", "Email", "Phone", "Address",
        "PaymentTerms", "CreditLimit", "Status", "OwnerSalesId"
      ],
      "pii_fields": ["TaxCode", "Email", "Phone", "Address"],
      "retention_years": 10,
      "immutable": true,
      "compliance_tags": ["VN-PDPL", "GDPR"],
      "_comment": "Customer là PII subject — audit log đầy đủ cho compliance"
    },

    "Employee": {
      "owner_module": "HRM",
      "audit_table": "hrm.audit_employee_log",
      "audit_required_actions": ["CREATE", "UPDATE", "DELETE", "PII_READ", "SALARY_CHANGE", "CONTRACT_CHANGE"],
      "tracked_fields": [
        "FullName", "NationalId", "Phone", "Email", "Address",
        "DepartmentId", "PositionId", "Salary", "ContractType", "Status"
      ],
      "pii_fields": ["NationalId", "Phone", "Email", "Address", "Salary"],
      "retention_years": 10,
      "immutable": true,
      "compliance_tags": ["VN-PDPL", "VN-LABOR-CODE"]
    },

    "Invoice": {
      "owner_module": "Finance",
      "audit_table": "finance.audit_invoice_log",
      "audit_required_actions": ["CREATE", "UPDATE_DRAFT", "ISSUE", "CANCEL_DRAFT", "CREDIT_NOTE", "PAYMENT_LINK"],
      "tracked_fields": [
        "InvoiceNumber", "EInvoiceCode", "CustomerId", "TotalAmount", "Currency",
        "TaxAmount", "Status", "IssuedAt", "TaxAuthorityVerifiedAt"
      ],
      "retention_years": 10,
      "immutable": true,
      "compliance_tags": ["VN-TT78-eInvoice", "audit-immutable"],
      "_comment": "Invoice issued không cho UPDATE — chỉ credit note. Audit log capture mọi attempt."
    },

    "Payment": {
      "owner_module": "Finance",
      "audit_table": "finance.audit_payment_log",
      "audit_required_actions": ["CREATE", "CONFIRM", "REFUND", "FAILURE"],
      "tracked_fields": [
        "Amount", "Currency", "Method", "GatewayResponse", "Status", "InvoiceId"
      ],
      "retention_years": 10,
      "immutable": true
    },

    "JournalEntry": {
      "owner_module": "Finance",
      "audit_table": "finance.audit_journal_log",
      "audit_required_actions": ["CREATE", "POST", "REVERSE"],
      "tracked_fields": ["DebitAccount", "CreditAccount", "Amount", "Description", "PeriodId"],
      "retention_years": 10,
      "immutable": true,
      "_comment": "Journal entry posted không cho update — phải reverse + tạo mới"
    },

    "CustomsDeclaration": {
      "owner_module": "Customs",
      "audit_table": "customs.audit_declaration_log",
      "audit_required_actions": ["CREATE", "UPDATE", "SUBMIT", "REJECT", "AMEND", "CANCEL"],
      "tracked_fields": [
        "DeclarationNumber", "RegistrationNumber", "HSCode", "Value",
        "Status", "TaxAuthorityResponse", "AmendmentReason"
      ],
      "retention_years": 5,
      "immutable": true,
      "compliance_tags": ["VN-VNACCS", "CN-H2010"]
    },

    "Order": {
      "owner_module": "Orders",
      "audit_table": "orders.audit_order_log",
      "audit_required_actions": ["CREATE", "UPDATE", "CONFIRM", "CANCEL", "STATUS_CHANGE"],
      "tracked_fields": [
        "OrderNumber", "CustomerId", "QuotationId", "TotalAmount", "Currency", "Status"
      ],
      "retention_years": 7,
      "immutable": true
    },

    "PurchaseOrder": {
      "owner_module": "Sourcing",
      "audit_table": "sourcing.audit_po_log",
      "audit_required_actions": ["CREATE", "UPDATE", "APPROVE", "SEND", "RECEIVE", "CANCEL"],
      "tracked_fields": [
        "PONumber", "VendorId", "TotalAmount", "ApprovalUserId", "Status"
      ],
      "retention_years": 7,
      "immutable": true,
      "compliance_tags": ["audit-immutable", "anti-fraud"]
    },

    "Shipment": {
      "owner_module": "TMS",
      "audit_table": "tms.audit_shipment_log",
      "audit_required_actions": ["CREATE", "STATUS_CHANGE", "TRACKING_UPDATE", "CANCEL"],
      "tracked_fields": [
        "BookingNumber", "BillOfLadingNumber", "CarrierId", "Status",
        "PickedUpAt", "DeliveredAt", "TrackingLocation"
      ],
      "retention_years": 5,
      "immutable": true
    },

    "Tariff": {
      "owner_module": "TMS",
      "audit_table": "tms.audit_tariff_log",
      "audit_required_actions": ["CREATE", "UPDATE", "PUBLISH", "ARCHIVE"],
      "tracked_fields": [
        "TariffCode", "EffectiveDate", "ExpiryDate", "BasePrice", "Currency", "Status"
      ],
      "retention_years": 7,
      "immutable": true,
      "_comment": "Tariff version-controlled. Mỗi publish = new version, không edit in-place."
    },

    "RoleAssignment": {
      "owner_module": "Settings",
      "audit_table": "settings.audit_role_assignment_log",
      "audit_required_actions": ["GRANT_ROLE", "REVOKE_ROLE", "GRANT_PERMISSION", "REVOKE_PERMISSION"],
      "tracked_fields": ["UserId", "RoleId", "PermissionCode", "GrantedByUserId", "Reason"],
      "retention_years": 10,
      "immutable": true,
      "compliance_tags": ["audit-immutable", "security-critical"]
    },

    "TaxDeclaration": {
      "owner_module": "Tax",
      "audit_table": "tax.audit_declaration_log",
      "audit_required_actions": ["CREATE", "UPDATE", "SUBMIT", "AMEND"],
      "tracked_fields": [
        "DeclarationType", "PeriodId", "TaxAmount", "Status", "AuthorityResponse"
      ],
      "retention_years": 10,
      "immutable": true,
      "compliance_tags": ["VN-VAT-LAW"]
    },

    "ApprovalRequest": {
      "owner_module": "Approval",
      "audit_table": "approval.audit_request_log",
      "audit_required_actions": ["CREATE", "VIEW", "APPROVE", "REJECT", "CANCEL"],
      "tracked_fields": [
        "RequestType", "TargetEntityId", "Amount", "ApproverUserId", "Decision", "Reason"
      ],
      "retention_years": 7,
      "immutable": true
    }
  },

  "pii_access_logging": {
    "description": "Compliance VN-PDPL Điều 6 — Mọi truy cập PII PHẢI log.",
    "audit_table": "compliance.audit_pii_access_log",
    "required_fields": [
      "Id", "Timestamp", "AccessorUserId", "AccessorClientIp", "AccessorUserAgent",
      "EntityType", "EntityId", "AccessType",
      "FieldsAccessed", "Purpose", "TenantId", "CorrelationId"
    ],
    "access_types": ["READ_SINGLE", "READ_LIST", "EXPORT_CSV", "EXPORT_PDF", "API_FETCH", "BULK_QUERY"],
    "retention_years": 5,
    "immutable": true,
    "compliance_tags": ["VN-PDPL", "GDPR"],
    "_comment": "Trigger ở DB layer hoặc Application layer middleware. Bắt buộc cho mọi PII entity read access."
  },

  "system_audit_categories": {
    "description": "System-level audit events.",

    "AuthenticationEvents": {
      "audit_table": "settings.audit_auth_log",
      "events": [
        "LOGIN_SUCCESS", "LOGIN_FAILURE", "LOGOUT",
        "PASSWORD_CHANGE", "PASSWORD_RESET", "PASSWORD_RESET_REQUEST",
        "MFA_ENABLE", "MFA_DISABLE", "MFA_CHALLENGE_FAILURE",
        "SESSION_EXPIRED", "ACCOUNT_LOCKED"
      ],
      "retention_years": 3
    },

    "ConfigurationChanges": {
      "audit_table": "settings.audit_config_log",
      "events": [
        "FEATURE_FLAG_TOGGLE", "TENANT_SETTING_UPDATE",
        "SYSTEM_CONFIG_UPDATE", "INTEGRATION_KEY_ROTATE"
      ],
      "retention_years": 7,
      "compliance_tags": ["audit-immutable", "security-critical"]
    },

    "DataExports": {
      "audit_table": "compliance.audit_export_log",
      "events": [
        "EXPORT_CSV", "EXPORT_PDF", "EXPORT_EXCEL",
        "API_BULK_DOWNLOAD", "REPORT_EMAIL_SENT"
      ],
      "retention_years": 5,
      "_comment": "Track ai export cái gì khi nào — anti data leak"
    },

    "IntegrationEvents": {
      "audit_table": "settings.audit_integration_log",
      "events": [
        "WEBHOOK_RECEIVED", "WEBHOOK_DELIVERY_FAILED",
        "API_KEY_USED", "EXTERNAL_API_CALL"
      ],
      "retention_years": 1
    }
  },

  "audit_log_schema": {
    "description": "Schema chuẩn cho mọi audit_*_log table.",
    "required_columns": [
      {"name": "Id", "type": "GUID", "primary_key": true},
      {"name": "Timestamp", "type": "TIMESTAMP_UTC", "indexed": true, "non_nullable": true},
      {"name": "EntityType", "type": "VARCHAR(100)", "indexed": true},
      {"name": "EntityId", "type": "VARCHAR(50)", "indexed": true},
      {"name": "Action", "type": "VARCHAR(50)", "non_nullable": true},
      {"name": "ActorUserId", "type": "GUID", "indexed": true, "nullable_for_system": true},
      {"name": "ActorClientIp", "type": "VARCHAR(45)"},
      {"name": "ChangedFields", "type": "JSONB", "_comment": "Trước/sau cho mỗi field"},
      {"name": "Reason", "type": "TEXT", "nullable_unless_required": true},
      {"name": "CorrelationId", "type": "GUID", "indexed": true},
      {"name": "TenantId", "type": "GUID", "indexed": true, "non_nullable": true, "rls": true}
    ],
    "indexes_required": [
      "(EntityType, EntityId, Timestamp DESC)",
      "(ActorUserId, Timestamp DESC)",
      "(TenantId, Timestamp DESC)",
      "(CorrelationId)"
    ],
    "constraints": [
      "NO UPDATE",
      "NO DELETE",
      "PARTITION BY MONTH",
      "ARCHIVE AFTER retention_years TO COLD STORAGE"
    ]
  },

  "validation_rules": {
    "description": "Top-level rules cho CD29.",
    "rules": [
      {
        "id": "RULE-CD29-001",
        "name": "audit_table_exists",
        "description": "Mỗi entity audit_critical PHẢI có audit_table trong DB schema",
        "severity": "CRITICAL"
      },
      {
        "id": "RULE-CD29-002",
        "name": "audit_required_actions_implemented",
        "description": "Mọi audit_required_actions PHẢI có code path ghi log (interceptor, EF SaveChanges, hoặc explicit call)",
        "severity": "CRITICAL"
      },
      {
        "id": "RULE-CD29-003",
        "name": "audit_log_immutable",
        "description": "audit_table KHÔNG được có UPDATE/DELETE statement trong code. Vi phạm → AUDIT_MUTABILITY_VIOLATION",
        "severity": "CRITICAL"
      },
      {
        "id": "RULE-CD29-004",
        "name": "tracked_fields_captured",
        "description": "Mỗi field trong tracked_fields PHẢI captured trong ChangedFields JSONB khi thay đổi",
        "severity": "HIGH"
      },
      {
        "id": "RULE-CD29-005",
        "name": "pii_read_logged",
        "description": "Entity có pii_fields → mỗi READ access PHẢI ghi pii_access_log",
        "severity": "CRITICAL",
        "compliance_tags": ["VN-PDPL"]
      },
      {
        "id": "RULE-CD29-006",
        "name": "correlation_id_propagated",
        "description": "Audit log PHẢI có CorrelationId từ request context",
        "severity": "HIGH"
      },
      {
        "id": "RULE-CD29-007",
        "name": "retention_policy_enforced",
        "description": "Audit log PHẢI có archival job cleanup older than retention_years",
        "severity": "MEDIUM"
      },
      {
        "id": "RULE-CD29-008",
        "name": "audit_query_performance",
        "description": "Query 'audit log of entity X' PHẢI hoàn thành < max_audit_query_seconds (5s)",
        "severity": "MEDIUM"
      }
    ]
  },

  "exclusions": {
    "description": "Entities/actions explicitly excluded từ CD29 check.",
    "entity_exclusions": [
      {"entity": "TempFile", "reason": "Transient, no audit needed"},
      {"entity": "Session", "reason": "Tracked in auth_log instead"},
      {"entity": "CacheEntry", "reason": "Infrastructure"}
    ],
    "action_exclusions": [
      {"entity": "Notification", "action": "MARK_READ", "reason": "Behavioral, không phải compliance event"},
      {"entity": "*", "action": "VIEW_LIST", "reason": "Không log mỗi list view (chỉ log explicit pii_access)"}
    ]
  },

  "_appendix": {
    "_changelog": [
      {
        "version": "1.0.0-template",
        "date": "2026-05-16",
        "changes": "Initial template cho EUREKA-2026. 13 audit-critical entities + PII access logging + 4 system audit categories + audit schema standard."
      }
    ],
    "_references": [
      ".claude/skills/workflow/wf-cmi/SKILL.md (CD29 spec)",
      "plans/wf-cmi/compliance-mapping.eureka-template.json (regulations driving audit)",
      "EUREKA-2026/apps/backend/Eureka.Infrastructure/Audit/"
    ],
    "_maintenance": "Update khi: (a) thêm entity audit-critical (b) regulation mới yêu cầu (c) đổi retention policy. Khuyến nghị: auto-generate seed từ EF Core attribute [Auditable] hoặc IAuditable interface."
  }
}
