{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dimension-applicability-v1",
  "title": "Dimension Applicability Map — Phase 2 Spike Output",
  "description": "Pre-map mỗi module với các dimension QD1-QD11 applicable, để Phase 3 routing thông minh + Phase 4 lanes skip probes vô nghĩa.",
  "type": "object",
  "required": ["$schema", "session_id", "generated_at", "modules", "global", "summary"],
  "properties": {
    "$schema": {"const": "dimension-applicability-v1"},
    "session_id": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},

    "global": {
      "description": "Signals + applicability cấp project",
      "type": "object",
      "required": ["signals", "applicable_dims"],
      "properties": {
        "signals": {
          "type": "object",
          "properties": {
            "has_money": {"type": "boolean"},
            "has_auth": {"type": "boolean"},
            "has_db": {"type": "boolean"},
            "has_api": {"type": "boolean"},
            "has_ui": {"type": "boolean"},
            "has_i18n": {"type": "boolean"},
            "has_responsive": {"type": "boolean"},
            "has_browser_test": {"type": "boolean"},
            "has_cross_module": {"type": "boolean"},
            "is_multi_app": {"type": "boolean"}
          }
        },
        "applicable_dims": {"type": "array", "items": {"type": "string"}},
        "skip_dims": {"type": "array", "items": {"type": "string"}}
      }
    },

    "modules": {
      "description": "Per-module dimension mapping",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["module", "applicable_dims", "signals"],
        "properties": {
          "module": {"type": "string"},
          "module_type": {"enum": ["frontend", "backend", "mobile", "shared", "infrastructure", "config", "unknown"]},
          "applicable_dims": {
            "description": "Dimensions với probes có ý nghĩa",
            "type": "array",
            "items": {"enum": ["QD1", "QD2", "QD3", "QD4", "QD5", "QD6", "QD7", "QD8", "QD9", "QD10", "QD11"]}
          },
          "skip_dims": {
            "description": "Dimensions không applicable cho module này",
            "type": "array",
            "items": {"type": "string"}
          },
          "skip_reasons": {
            "type": "object",
            "description": "Map dim → lý do skip (vd: QD9: 'no browser test infra')"
          },
          "signals": {
            "type": "object",
            "properties": {
              "has_money": {"type": "boolean"},
              "has_auth": {"type": "boolean"},
              "has_db": {"type": "boolean"},
              "has_api": {"type": "boolean"},
              "has_ui": {"type": "boolean"},
              "has_i18n": {"type": "boolean"},
              "has_form": {"type": "boolean"},
              "has_responsive": {"type": "boolean"},
              "has_state_machine": {"type": "boolean"},
              "imports_from_other_modules": {"type": "integer"},
              "file_count": {"type": "integer"},
              "framework_hints": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    },

    "summary": {
      "type": "object",
      "required": ["total_modules", "avg_applicable_dims", "total_skippable_probes_estimate"],
      "properties": {
        "total_modules": {"type": "integer"},
        "avg_applicable_dims": {"type": "number"},
        "avg_skip_dims": {"type": "number"},
        "total_skippable_probes_estimate": {
          "type": "integer",
          "description": "Số probe có thể skip nếu Phase 4 consume map này (so với baseline tất cả 11 lanes x ~5 probes)"
        },
        "duration_seconds": {"type": "number"}
      }
    }
  }
}
